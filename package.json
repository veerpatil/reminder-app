{
  "name": "bolt-reminder",
  "version": "1.0.0",
  "description": "Armored hero reminders — Bolt drops in when it's time (macOS & Windows)",
  "main": "bootstrap.js",
  "author": "Veerkumar",
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "postinstall": "node node_modules/electron/install.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.bolt.reminder",
    "productName": "Bolt Reminder",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
